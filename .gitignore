# Byte-compiled / build
**/target/
*.rlib
web/node_modules/
scripts/.tools/
web/build/
web/.svelte-kit/
web/.vite/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# data/
.nightjar/
*.db
*.db-*

# Large/generated-only corpus blobs (see testdata/generate.sh); small seeds are tracked
testdata/files/large-*
testdata/files/soak_scrub_*
testdata/files/.generated
testdata/files/dolby-vision-browser-kit/
testdata/files/dolby-vision-makemkv/
testdata/bench_10k/
testdata/.bench_seed.mp4

# Local dogfood screenshot dumps (never ship)
tmp_safari_cue_check/

# Spike C encode + probe workdir (regenerated by spike_c_burn_splice.sh)
scripts/spike_c_work/

# Playlist-shape probe artefacts (regenerated by build.sh)
scripts/playlist_shape_probe/work/
scripts/playlist_shape_probe/static/media/
scripts/playlist_shape_probe/static/hls.min.js
.tmp-ffmpeg-*/

# Script bytecode
scripts/__pycache__/

# Gate 2 orphan soak live logs (script is tracked; runs are local)
notes/gate2/

# Hardware encode-leg spike output: raw .mp4 test clips (GIT_RULES.md §4 bars
# media outside testdata/, which is Git LFS only). Local scratch, never ship.
notes/hw/encode-leg-spike-mac/

# Stray npm lockfile from a misdirected `npm init`/`npm install` in notes/ —
# no package.json alongside it, empty dependency graph, not part of any
# tracked tool. Local scratch, never ship.
notes/package-lock.json

# Raw (unhashed) probe CSVs from subtitle_inventory_scan.py /
# keyframe_index_probe.py / client_timeline_probe.py: real filesystem paths,
# never committed. Run those scripts with --hash-paths for anything meant to
# be committed; if you must keep a raw copy locally, name it with -raw so it
# is caught here.
notes/*-raw*.csv
notes/*.raw.csv


# Local toolchains / container caches (never ship)
.tools/
.cargo-docker/
server/target-docker/
dist/

# Engine bake-off generated Flutter output
apps/engine-bakeoff/build/
apps/engine-bakeoff/macos/Pods/
apps/engine-bakeoff/macos/Flutter/
apps/engine-bakeoff/macos/ephemeral/
scripts/abr_throttle_probe/
